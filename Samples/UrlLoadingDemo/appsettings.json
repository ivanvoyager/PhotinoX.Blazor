{
  "PhotinoX": {

    "Blazor": {
      "AppBaseUri": "app://localhost/",
      "HostPage": "index.html"
    },

    "ApplicationName": "PhotinoX.Blazor UrlLoading Demo App",
    "WebRootPath": "wwwroot",

    "WindowDefaults": {
      "Window": {
        "CenterOnInitialize": true,
        "Resizable": true
      },
      "Browser": {
        "ContextMenuEnabled": true,
        "DevToolsEnabled": true
      }
    },

    "MainWindow": {
      "Window": {
        "Title": "PhotinoX.Blazor UrlLoading Demo",
        "Width": 960,
        "Height": 760
      }
    },

    "Runtime": {
      "WebView2RuntimePath": null
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}