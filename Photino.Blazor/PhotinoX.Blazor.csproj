<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Description>Blazor integration for PhotinoX (.NET wrapper for OS-native WebView windows). 
Maintained fork of Photino.Blazor.</Description>
		<RootNamespace>Photino.Blazor</RootNamespace>
		<VersionPrefix>5.5.0</VersionPrefix>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="8.0.34" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="9.0.23" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.15" />
	</ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(PhotinoX_UseLocalProjects)' != 'true'">
    <PackageReference Include="PhotinoX.App" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(PhotinoX_UseLocalProjects)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\PhotinoX.App\src\PhotinoX.App\PhotinoX.App.csproj" />
  </ItemGroup>

</Project>
